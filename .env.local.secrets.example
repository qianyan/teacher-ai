# Copy to .env.local.secrets and fill in your LLM credentials.
# This file is merged by `npm run provision:local` into the generated .env.local.
# Never commit .env.local.secrets (gitignored).

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Optional: disable the editor PIN gate in local dev (leave both empty)
# APP_LOCK_PIN=
# NEXT_PUBLIC_APP_LOCK_PIN=
