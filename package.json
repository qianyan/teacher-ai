{
  "name": "teacher-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:env": "tsx scripts/validate-env.test.ts",
    "env:validate": "tsx scripts/validate-env.ts",
    "env:validate:local": "tsx scripts/validate-env.ts --target local --env-file .env.local",
    "env:validate:preview": "tsx scripts/validate-env.ts --target preview",
    "env:validate:production": "tsx scripts/validate-env.ts --target production",
    "env:pull:preview": "npx vercel pull --yes --environment=preview",
    "env:pull:production": "npx vercel pull --yes --environment=production",
    "prepare:local": "npm run env:validate:local && npm run test:env",
    "prepare:preview": "npm run env:pull:preview && npm run env:validate -- --target preview --env-file .vercel/.env.preview.local",
    "prepare:production": "npm run env:pull:production && npm run env:validate -- --target production --env-file .vercel/.env.production.local",
    "verify:local": "npm run prepare:local && npm run build",
    "verify:preview": "npm run prepare:preview && npm run build",
    "verify:production": "npm run prepare:production && npm run build",
    "deploy:preview": "npm run verify:preview && npx vercel --yes",
    "deploy:production": "npm run verify:production && npx vercel --prod --yes",
    "playwright:install": "playwright install chromium",
    "e2b:build-template": "tsx e2b/build-template.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@sparticuz/chromium": "^147.0.0",
    "@supabase/supabase-js": "^2.104.1",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "next": "^15.1.0",
    "openai": "^4.77.0",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.5",
    "e2b": "^2.31.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
