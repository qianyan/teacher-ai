{
  "name": "teacher-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:env": "tsx scripts/validate-env.test.ts",
    "test:ci-db-safety": "tsx scripts/check-ci-db-safety.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "smoke:preview": "tsx scripts/smoke-preview.ts",
    "env:validate": "tsx scripts/validate-env.ts",
    "env:validate:local": "tsx scripts/validate-env.ts --target local --env-file .env.local",
    "env:validate:preview": "tsx scripts/validate-env.ts --target preview",
    "env:validate:production": "tsx scripts/validate-env.ts --target production",
    "env:pull:preview": "npx vercel pull --yes --environment=preview",
    "env:pull:production": "npx vercel pull --yes --environment=production",
    "prepare:local": "npm run env:validate:local && npm run test:env",
    "prepare:preview": "npm run env:pull:preview && npm run env:validate -- --target preview --env-file .vercel/.env.preview.local",
    "prepare:production": "npm run env:pull:production && npm run env:validate -- --target production --env-file .vercel/.env.production.local",
    "verify:local": "npm run prepare:local && npm run build",
    "verify:preview": "npm run prepare:preview && npm run build",
    "verify:production": "npm run prepare:production && npm run build",
    "deploy:preview": "npm run verify:preview && npx vercel --yes",
    "deploy:production": "npm run verify:production && npx vercel --prod --yes",
    "playwright:install": "playwright install chromium",
    "e2b:build-template": "tsx e2b/build-template.ts",
    "provision:local": "tsx scripts/provision-local.ts",
    "db:migrate:local": "tsx scripts/migrate-db.ts --target local",
    "db:migrate:remote": "tsx scripts/migrate-db.ts --target linked",
    "db:reset:local": "tsx scripts/migrate-db.ts --target local --reset",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:status": "npx supabase status",
    "photos:cleanup-orphans": "tsx scripts/cleanup-orphan-photos.ts",
    "photos:cleanup-orphans:delete": "tsx scripts/cleanup-orphan-photos.ts --delete"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@sparticuz/chromium": "^147.0.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.104.1",
    "@tiptap/extension-placeholder": "^2.11.5",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/react": "^2.11.5",
    "@tiptap/starter-kit": "^2.11.5",
    "heic2any": "^0.0.4",
    "html-to-image": "^1.11.13",
    "next": "^15.1.0",
    "openai": "^4.77.0",
    "playwright": "^1.59.1",
    "playwright-core": "^1.59.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.5",
    "e2b": "^2.31.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.9"
  }
}
