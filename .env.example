# --- OpenAI-compatible (default): OpenAI, 通义 DashScope, 智谱 GLM, Moonshot/Kimi, MiniMax, SiliconFlow, … ---
LLM_PROVIDER=openai_compatible
# Base URL for the provider’s OpenAI-compatible endpoint (leave empty for api.openai.com)
LLM_BASE_URL=
# Model id, e.g. gpt-4o-mini, qwen-turbo, glm-4, moonshot-v1-8k, …
LLM_MODEL=gpt-4o-mini
# Any of: LLM_API_KEY, OPENAI_API_KEY, DASHSCOPE_API_KEY, ZHIPUAI_API_KEY, MOONSHOT_API_KEY, MINIMAX_API_KEY
LLM_API_KEY=

# --- Anthropic Claude (set LLM_PROVIDER=anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional cap for generate route
REPORT_GENERATE_MAX_TOKENS=8192

# --- Editor lock screen (optional) ---
# If set, the home page shows a PIN gate before editing. PIN is checked client-side for the
# text field; use APP_LOCK_PIN (server-only) so the same secret is not in the JS bundle.
# NEXT_PUBLIC_APP_LOCK_PIN is still used by the client unlock UI when APP_LOCK_PIN is unset.
# Leave both empty to disable the lock in local dev.
NEXT_PUBLIC_APP_LOCK_PIN=
# Optional server-only PIN (recommended if you enable passkey registration / WebAuthn).
APP_LOCK_PIN=

# --- WebAuthn / passkeys (session lock biometric unlock) ---
# Requires Supabase + migration session_passkeys / session_webauthn_challenges.
# rpID: hostname only, no port (use "localhost" for local dev).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Teacher AI
# Comma-separated allowed origins (must match the browser URL exactly), e.g.:
#   http://localhost:3000
#   https://your-domain.com
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Vercel Blob (optional, for “下载 HTML” with public image URLs) ---
# In Vercel: Project → Storage → Create / Connect Blob store (link it to this project).
# Then either copy the auto-added token or run: vercel env pull
# Name must be exactly (server-only, never NEXT_PUBLIC_*):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# Add for Production + Preview, redeploy. Without it, “下载 HTML” falls back to base64.

# --- Local QA (optional) ---
# Long PNG from the app uses Node Playwright (POST /api/long-screenshot). After clone:
#   npm run playwright:install
# CLI equivalent: python3 scripts/generate-long-screenshot.py ./your-report.html

# --- Supabase (history API + WebAuthn passkey storage) ---
# History records are saved server-side via /api/history.
# Passkeys for biometric unlock use tables session_passkeys & session_webauthn_challenges.
# Required on server: service-role key (never expose to browser).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
