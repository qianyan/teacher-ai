# --- OpenAI-compatible (default): OpenAI, 通义 DashScope, 智谱 GLM, Moonshot/Kimi, MiniMax, SiliconFlow, … ---
LLM_PROVIDER=openai_compatible
# Base URL for the provider’s OpenAI-compatible endpoint (leave empty for api.openai.com)
LLM_BASE_URL=
# Model id, e.g. gpt-4o-mini, qwen-turbo, glm-4, moonshot-v1-8k, …
LLM_MODEL=gpt-4o-mini
# Any of: LLM_API_KEY, OPENAI_API_KEY, DASHSCOPE_API_KEY, ZHIPUAI_API_KEY, MOONSHOT_API_KEY, MINIMAX_API_KEY
LLM_API_KEY=

# --- Anthropic Claude (set LLM_PROVIDER=anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional guard rails for generate route (help avoid serverless timeout)
REPORT_GENERATE_MAX_TOKENS=3072
REPORT_LLM_REQUEST_TIMEOUT_MS=25000
REPORT_GENERATE_MAX_TOOL_ITERATIONS=8
# Optional fallback: allow model tool-calls when preloaded static blocks are insufficient.
# Default behavior is preloaded-only (no tools) for fewer round-trips.
REPORT_GENERATE_ENABLE_TOOLS_FALLBACK=false

# --- Editor lock screen (optional) ---
# If set, the home page shows a PIN gate before editing. Compared client-side only; do not commit real secrets.
# Leave empty to disable the lock in local dev.
NEXT_PUBLIC_APP_LOCK_PIN=

# --- Vercel Blob (optional, for “下载 HTML” with public image URLs) ---
# In Vercel: Project → Storage → Create / Connect Blob store (link it to this project).
# Then either copy the auto-added token or run: vercel env pull
# Name must be exactly (server-only, never NEXT_PUBLIC_*):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# Add for Production + Preview, redeploy. Without it, “下载 HTML” falls back to base64.

# --- Local QA (optional) ---
# Long PNG from the app uses Node Playwright (POST /api/long-screenshot). After clone:
#   npm run playwright:install
# CLI equivalent: python3 scripts/generate-long-screenshot.py ./your-report.html
