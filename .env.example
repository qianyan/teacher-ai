# --- Deployment validation ---
# Validate environment variables before running or deploying:
#   npm run env:validate:local
#   npm run env:validate:preview
#   npm run env:validate:production
#
# local: LLM credentials are required for generation; Supabase, WebAuthn, and E2B may be absent.
# preview/production: LLM and Supabase variables are required.
# production: WebAuthn origins must be HTTPS and WEBAUTHN_RP_ID must be your real hostname.

# --- OpenAI-compatible (default): OpenAI, 通义 DashScope, 智谱 GLM, Moonshot/Kimi, MiniMax, SiliconFlow, … ---
LLM_PROVIDER=openai_compatible
# Base URL for the provider’s OpenAI-compatible endpoint (leave empty for api.openai.com)
LLM_BASE_URL=
# Model id, e.g. gpt-4o-mini, qwen-turbo, glm-4, moonshot-v1-8k, …
LLM_MODEL=gpt-4o-mini
# Any of: LLM_API_KEY, OPENAI_API_KEY, DASHSCOPE_API_KEY, ZHIPUAI_API_KEY, MOONSHOT_API_KEY, MINIMAX_API_KEY
LLM_API_KEY=

# --- Anthropic Claude (set LLM_PROVIDER=anthropic) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional cap for generate route
REPORT_GENERATE_MAX_TOKENS=8192

# --- Editor lock screen (optional) ---
# If set, the home page shows a PIN gate before editing. PIN is checked client-side for the
# text field; use APP_LOCK_PIN (server-only) so the same secret is not in the JS bundle.
# NEXT_PUBLIC_APP_LOCK_PIN is still used by the client unlock UI when APP_LOCK_PIN is unset.
# Leave both empty to disable the lock in local dev.
NEXT_PUBLIC_APP_LOCK_PIN=
# Optional server-only PIN (recommended if you enable passkey registration / WebAuthn).
APP_LOCK_PIN=

# --- WebAuthn / passkeys (session lock biometric unlock) ---
# Requires Supabase + migration session_passkeys / session_webauthn_challenges.
# rpID: hostname only, no port (use "localhost" for local dev).
# Production must use the deployed hostname, not localhost.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Teacher AI
# Comma-separated allowed origins (must match the browser URL exactly), e.g.:
#   http://localhost:3000
#   https://your-domain.com
# Production origins must use https://.
WEBAUTHN_ORIGIN=http://localhost:3000

# --- Supabase Storage (report photos → public URLs in exported HTML) ---
# Create a bucket (default name: report-photos), set it Public. Optional override:
# SUPABASE_REPORT_PHOTOS_BUCKET=report-photos
# Policies: allow public read; signed uploads use service role — no anon INSERT required for this flow.
# Browser uploads need the anon (or publishable) key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Local QA (optional) ---
# Long PNG from the app uses Node Playwright (POST /api/long-screenshot). After clone:
#   npm run playwright:install
# CLI equivalent: python3 scripts/generate-long-screenshot.py ./your-report.html
#
# --- E2B (optional, recommended on Vercel) ---
# When both are set, long screenshots run in an E2B sandbox (stock Chromium) instead of
# in-process @sparticuz/chromium. Build the template once: see e2b/README.md and npm run e2b:build-template
# E2B_API_KEY=
# E2B_LONG_SCREENSHOT_TEMPLATE=teacher-ai-long-screenshot

# --- Supabase (history API + WebAuthn + report photo storage) ---
# History records are saved server-side via /api/history.
# Passkeys for biometric unlock use tables session_passkeys & session_webauthn_challenges.
# Report photos: Storage bucket + URL above; service role for API routes (never expose to browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
